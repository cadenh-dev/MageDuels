; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="SHIFTCAST"
config/description="A 2.5D wizard duel where you craft spells from runes and cast them by typing."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.035, 0.027, 0.075, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/core/game.gd"
SpellData="*res://scripts/core/spell_data.gd"
Audio="*res://scripts/core/audio.gd"
AsciiFx="*res://scripts/world/ascii_fx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="SHIFTCAST"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.027, 0.075, 1)
anti_aliasing/quality/msaa_3d=2

[audio]

driver/enable_input=false

[input_devices]

pointing/emulate_touch_from_mouse=false
